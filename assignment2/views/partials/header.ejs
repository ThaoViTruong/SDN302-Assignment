<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= pageTitle || "Question Bank" %></title>
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <main class="container app-shell">
        <% const activeTab = typeof currentTab !== "undefined" ? currentTab : ""; %>
        <div class="app-tabs">
            <a
                href="/quizzes"
                class="app-tab <%= activeTab === 'quizzes' ? 'app-tab-active' : '' %>"
            >
                Quiz
            </a>
            <a
                href="/questions"
                class="app-tab <%= activeTab === 'questions' ? 'app-tab-active' : '' %>"
            >
                Question
            </a>
        </div>
