<%- include("../partials/header") %>

<h1 class="page-title">Questions</h1>

<div class="mb-4">
    <a href="/questions/create" class="btn btn-primary">Create New Question</a>
</div>

<% if (questions.length) { %>
    <div class="simple-list">
        <% questions.forEach(question => { %>
            <div class="simple-list-item">
                <a href="/questions/<%= question._id %>" class="simple-list-link">
                    <%= question.text %>
                </a>
                <form
                    action="/questions/<%= question._id %>?_method=DELETE"
                    method="POST"
                    class="confirm-form"
                    data-confirm-message="Delete this question?"
                >
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
            </div>
        <% }) %>
    </div>
<% } %>

<%- include("../partials/footer") %>
